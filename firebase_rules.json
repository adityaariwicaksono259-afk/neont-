{
  "rules": {
    "users": {
      "$uid": {
        ".read": "auth != null",
        ".write": "$uid === auth.uid",
        "username": { ".validate": "newData.isString() && newData.val().length <= 25" },
        "name": { ".validate": "newData.isString() && newData.val().length <= 50" }
      }
    },
    "usernames": {
      "$username": {
        ".read": "auth != null",
        ".write": "!data.exists() || data.val() === auth.uid"
      }
    },
    "chats": {
      "$roomId": {
        ".read": "auth != null",
        ".write": "auth != null",
        "$messageId": {
          "text": { ".validate": "newData.isString() && newData.val().length <= 4000" },
          "senderId": { ".validate": "newData.val() === auth.uid" },
          "timestamp": { ".validate": "newData.isNumber()" }
        }
      }
    },
    "typing": {
      "$roomId": {
        "$uid": {
          ".write": "$uid === auth.uid",
          ".validate": "newData.isBoolean()"
        }
      }
    },
    "blocks": {
      "$uid": {
        ".read": "$uid === auth.uid",
        ".write": "$uid === auth.uid"
      }
    }
  }
}
