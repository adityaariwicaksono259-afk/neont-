<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/tg_bg" android:fillViewport="true">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="32dp" android:gravity="center">

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="NEONT" android:textSize="48sp" android:textStyle="bold"
            android:textColor="@color/tg_blue" android:layout_marginTop="64dp" android:layout_marginBottom="48dp"/>

        <EditText android:id="@+id/etEmail" android:layout_width="match_parent" android:layout_height="50dp"
            android:hint="Email" android:inputType="textEmailAddress" android:background="@drawable/bg_search_telegram"
            android:padding="12dp" android:layout_marginBottom="16dp"
            android:importantForAutofill="no" android:autofillHints="" />

        <EditText android:id="@+id/etPassword" android:layout_width="match_parent" android:layout_height="50dp"
            android:hint="Password" android:inputType="textPassword" android:background="@drawable/bg_search_telegram"
            android:padding="12dp" android:layout_marginBottom="24dp"
            android:importantForAutofill="no" android:autofillHints="" />

        <Button android:id="@+id/btnLogin" android:layout_width="match_parent" android:layout_height="50dp"
            android:text="LOGIN" android:backgroundTint="@color/tg_blue" android:textColor="#FFFFFF" android:layout_marginBottom="8dp"/>

        <Button android:id="@+id/btnRegister" android:layout_width="match_parent" android:layout_height="50dp"
            android:text="REGISTER" android:backgroundTint="@color/tg_bg_gray" android:textColor="@color/tg_text"/>
    </LinearLayout>
</ScrollView>
