<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@color/tg_bg" android:padding="16dp">

    <EditText android:id="@+id/etUsername" android:layout_width="match_parent" android:layout_height="52dp"
        android:hint="Masukkan @username" android:background="@drawable/bg_input_telegram"
        android:padding="16dp" android:layout_marginBottom="16dp"/>

    <EditText android:id="@+id/etName" android:layout_width="match_parent" android:layout_height="52dp"
        android:hint="Simpan dengan nama..." android:background="@drawable/bg_input_telegram"
        android:padding="16dp" android:layout_marginBottom="16dp"/>

    <Button android:id="@+id/btnAdd" android:layout_width="match_parent" android:layout_height="52dp"
        android:text="TAMBAH KONTAK" android:background="@drawable/bg_button_telegram"
        android:textColor="#FFFFFF"/>
</LinearLayout>
