<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/nb_bg"
    android:padding="24dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Tambah Kontak Baru"
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="@color/nb_black"
        android:layout_marginBottom="24dp"/>

    <!-- Kotak Input dengan Shadow -->
    <EditText
        android:id="@+id/etContactCode"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:background="@drawable/nb_box_white"
        android:hint="Masukkan Kode (misal: NEO-6190)"
        android:padding="16dp"
        android:layout_marginBottom="16dp"
        android:importantForAutofill="no"/>

    <EditText
        android:id="@+id/etContactName"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:background="@drawable/nb_box_white"
        android:hint="Simpan dengan nama..."
        android:padding="16dp"
        android:layout_marginBottom="24dp"
        android:importantForAutofill="no"/>

    <!-- Tombol dengan animasi klik (foreground ripple) -->
    <Button
        android:id="@+id/btnSaveContact"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:background="@drawable/nb_button_bg"
        android:text="SIMPAN KONTAK"
        android:textColor="@color/nb_white"
        android:textStyle="bold"
        android:foreground="?attr/selectableItemBackground"
        android:stateListAnimator="@null"/>

</LinearLayout>
