<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/nb_bg"
    android:padding="24dp">

    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="PENGATURAN" android:textSize="24sp" android:textStyle="bold" android:textColor="@color/nb_black" android:layout_marginBottom="24dp"/>

    <!-- Keamanan: Ubah Password -->
    <Button
        android:id="@+id/btnUbahPassword"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:background="@drawable/nb_button_bg"
        android:text="UBAH PASSWORD"
        android:textColor="@color/nb_white"
        android:textStyle="bold"
        android:layout_marginBottom="16dp"/>

    <!-- Privasi: Sembunyiin Last Seen -->
    <Button
        android:id="@+id/btnPrivasi"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:background="@drawable/nb_button_bg"
        android:text="PRIVASI (LAST SEEN)"
        android:textColor="@color/nb_white"
        android:textStyle="bold"
        android:layout_marginBottom="16dp"/>

    <!-- Multi Akun: Logout Semua Device -->
    <Button
        android:id="@+id/btnLogoutAll"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:background="@drawable/nb_button_bg"
        android:text="KELUAR DARI SEMUA DEVICE"
        android:textColor="@color/nb_white"
        android:textStyle="bold"/>

</LinearLayout>
