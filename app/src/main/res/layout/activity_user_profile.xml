<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/nb_bg"
    android:padding="24dp"
    android:gravity="center_horizontal">

    <ImageView android:id="@+id/ivUserPhoto" android:layout_width="120dp" android:layout_height="120dp" android:src="@drawable/ic_wa_profile" android:background="@drawable/bg_avatar_circle" android:padding="20dp" android:layout_marginTop="32dp"/>
    <TextView android:id="@+id/tvUserName" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Nama User" android:textSize="24sp" android:textStyle="bold" android:layout_marginTop="16dp"/>
    <TextView android:id="@+id/tvUserUsername" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@username" android:textSize="16sp" android:textColor="#34B7F1"/>
    <TextView android:id="@+id/tvUserBio" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Bio disini" android:textSize="14sp" android:layout_marginTop="8dp"/>

    <Button android:id="@+id/btnMessageUser" android:layout_width="match_parent" android:layout_height="55dp" android:background="@drawable/nb_button_bg" android:text="KIRIM PESAN" android:textColor="@color/nb_white" android:layout_marginTop="32dp"/>
    <Button android:id="@+id/btnBlockUser" android:layout_width="match_parent" android:layout_height="55dp" android:background="@drawable/nb_button_bg" android:text="BLOKIR USER" android:textColor="@color/nb_white" android:layout_marginTop="16dp"/>
</LinearLayout>
