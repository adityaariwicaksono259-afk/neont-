<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F0F2F5">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- HEADER (Foto, Nama, Username) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="24dp"
            android:background="#FFFFFF">

            <ImageView
                android:id="@+id/ivUserPhoto"
                android:layout_width="96dp"
                android:layout_height="96dp"
                android:background="@drawable/bg_avatar_circle"
                android:src="@android:drawable/ic_menu_myplaces"
                android:padding="16dp"/>

            <TextView
                android:id="@+id/tvUserName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="User"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="#000000"
                android:layout_marginTop="12dp"/>

            <TextView
                android:id="@+id/tvUserUsername"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@user"
                android:textSize="14sp"
                android:textColor="#8E8E93"
                android:layout_marginTop="4dp"/>
        </LinearLayout>

        <!-- TOMBOL AKSI (Hanya untuk Profil Sendiri) -->
        <LinearLayout
            android:id="@+id/layoutSelfActions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="16dp"
            android:visibility="gone"
            android:background="#FFFFFF"
            android:layout_marginTop="1dp">

            <LinearLayout
                android:id="@+id/btnSetPhoto"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">
                <ImageView android:layout_width="24dp" android:layout_height="24dp" android:src="@android:drawable/ic_menu_camera" app:tint="#007AFF"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Pasang Foto" android:textSize="12sp" android:layout_marginTop="4dp"/>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/btnEditInfo"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">
                <ImageView android:layout_width="24dp" android:layout_height="24dp" android:src="@android:drawable/ic_menu_edit" app:tint="#007AFF"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Ubah Info" android:textSize="12sp" android:layout_marginTop="4dp"/>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/btnSettings"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">
                <ImageView android:layout_width="24dp" android:layout_height="24dp" android:src="@android:drawable/ic_menu_preferences" app:tint="#007AFF"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Pengaturan" android:textSize="12sp" android:layout_marginTop="4dp"/>
            </LinearLayout>
        </LinearLayout>

        <!-- DAFTAR PENGATURAN (Hanya untuk Profil Sendiri) -->
        <LinearLayout
            android:id="@+id/layoutSettingsList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"
            android:layout_marginTop="16dp"
            android:background="#FFFFFF">

            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Akun" android:textColor="#007AFF" android:textSize="13sp" android:padding="16dp" android:textStyle="bold"/>
            <TextView android:id="@+id/rowEditProfile" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Nomor, Username, Bio" android:padding="16dp" android:textSize="15sp"/>
            
            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#EEEEEE" android:layout_marginStart="16dp"/>
            
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Pengaturan Obrolan" android:padding="16dp" android:textSize="15sp"/>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Privasi &amp; Keamanan" android:padding="16dp" android:textSize="15sp"/>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Notifikasi" android:padding="16dp" android:textSize="15sp"/>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Data dan Penyimpanan" android:padding="16dp" android:textSize="15sp"/>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Folder Obrolan" android:padding="16dp" android:textSize="15sp"/>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Perangkat" android:padding="16dp" android:textSize="15sp"/>
        </LinearLayout>

        <!-- TOMBOL KIRIM PESAN (Hanya untuk Profil Orang Lain) -->
        <Button
            android:id="@+id/btnMessageUser"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Kirim Pesan"
            android:layout_margin="16dp"
            android:backgroundTint="#007AFF"
            android:textColor="#FFFFFF"/>
    </LinearLayout>
</ScrollView>
