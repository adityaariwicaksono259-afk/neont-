<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <!-- Preview Gambar Full Screen -->
    <ImageView
        android:id="@+id/ivStoryPreview"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"/>

    <!-- Gradient Hitam di Atas & Bawah (Biar tulisan kebaca) -->
    <View
        android:layout_width="match_parent"
        android:layout_height="100dp"
        android:background="#80000000"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:layout_width="match_parent"
        android:layout_height="100dp"
        android:background="#80000000"
        app:layout_constraintBottom_toBottomOf="parent"/>

    <!-- Tombol Back (Kiri Atas) -->
    <ImageView
        android:id="@+id/btnBackPreview"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_margin="16dp"
        android:src="@android:drawable/ic_menu_revert"
        app:tint="#FFFFFF"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>

    <!-- Tombol Pilih Gambar (Kanan Atas) -->
    <ImageView
        android:id="@+id/btnPickImage"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_margin="16dp"
        android:src="@android:drawable/ic_menu_gallery"
        app:tint="#FFFFFF"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- Kolom Caption (Kiri Bawah) -->
    <EditText
        android:id="@+id/etStoryCaption"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:hint="Tambah caption..."
        android:textColorHint="#CCCCCC"
        android:textColor="#FFFFFF"
        android:background="@android:color/transparent"
        android:padding="12dp"
        android:layout_margin="16dp"
        android:maxLines="3"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/btnPostStory"/>

    <!-- Tombol Kirim (Kanan Bawah, Icon Pesawat) -->
    <ImageView
        android:id="@+id/btnPostStory"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_margin="16dp"
        android:src="@android:drawable/ic_menu_send"
        app:tint="#00A884"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
