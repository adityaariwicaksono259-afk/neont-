<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="72dp"
    android:orientation="horizontal" android:padding="12dp" android:gravity="center_vertical"
    android:background="?attr/selectableItemBackground">

    <ImageView android:layout_width="54dp" android:layout_height="54dp"
        android:background="@drawable/bg_avatar_circle" android:padding="10dp" android:src="@drawable/ic_wa_profile"/>

    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
        android:layout_weight="1" android:orientation="vertical" android:layout_marginStart="12dp">
        <TextView android:id="@+id/tvName" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Nama User" android:textSize="16sp" android:textStyle="bold" android:textColor="@color/tg_text"/>
        <TextView android:id="@+id/tvPreview" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Klik untuk mulai chat" android:textSize="14sp" android:textColor="@color/tg_text_gray"
            android:maxLines="1" android:ellipsize="end"/>
    </LinearLayout>
</LinearLayout>
