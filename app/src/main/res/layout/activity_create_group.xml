<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@color/tg_bg" android:padding="16dp">

    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="Buat Grup/Channel" android:textSize="24sp" android:textStyle="bold"
        android:textColor="@color/tg_text" android:layout_marginBottom="24dp"/>

    <EditText android:id="@+id/etTitle" android:layout_width="match_parent" android:layout_height="52dp"
        android:hint="Nama Grup/Channel" android:background="@drawable/bg_input_telegram"
        android:padding="16dp" android:layout_marginBottom="16dp"/>

    <EditText android:id="@+id/etDescription" android:layout_width="match_parent" android:layout_height="100dp"
        android:hint="Deskripsi (opsional)" android:background="@drawable/bg_input_telegram"
        android:padding="16dp" android:gravity="top" android:layout_marginBottom="16dp"/>

    <CheckBox android:id="@+id/cbChannel" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="Jadikan Channel (read-only)" android:textColor="@color/tg_text" android:layout_marginBottom="16dp"/>

    <Button android:id="@+id/btnCreate" android:layout_width="match_parent" android:layout_height="52dp"
        android:text="BUAT" android:background="@drawable/bg_button_telegram" android:textColor="#FFFFFF"/>
</LinearLayout>
