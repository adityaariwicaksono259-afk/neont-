<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="horizontal" android:padding="4dp" android:gravity="start">

    <ImageView android:layout_width="32dp" android:layout_height="32dp"
        android:src="@drawable/ic_wa_profile" android:background="@drawable/bg_avatar_circle"
        android:padding="6dp" android:layout_marginEnd="8dp"/>

    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:background="@drawable/bg_bubble_received" android:orientation="vertical" android:padding="8dp">

        <!-- QUOTE (Reply) -->
        <LinearLayout android:id="@+id/layoutQuote" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:background="#20000000" android:padding="8dp"
            android:layout_marginBottom="4dp" android:visibility="gone">
            <TextView android:id="@+id/tvQuoteText" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Membalas pesan" android:textSize="12sp" android:textColor="#666666"/>
        </LinearLayout>

        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal">
            <TextView android:id="@+id/tvMessageText" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textColor="#000000" android:textSize="16sp" android:layout_marginEnd="8dp"/>
            <TextView android:id="@+id/tvMessageTime" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="12:00" android:textSize="10sp" android:textColor="#888888"/>
        </LinearLayout>

        <!-- REACTION -->
        <LinearLayout android:id="@+id/layoutReaction" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:orientation="horizontal" android:visibility="gone" android:layout_marginTop="4dp">
            <TextView android:id="@+id/tvReaction" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="❤️1" android:textSize="12sp"/>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
