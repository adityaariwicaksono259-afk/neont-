<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="4dp"
    android:gravity="end">
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_bubble_sent"
        android:padding="8dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">
        <ImageView android:layout_width="24dp" android:layout_height="24dp" android:src="@android:drawable/ic_media_play"/>
        <View android:layout_width="100dp" android:layout_height="4dp" android:background="#000000" android:layout_margin="8dp"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0:15" android:textSize="12sp"/>
    </LinearLayout>
</LinearLayout>
