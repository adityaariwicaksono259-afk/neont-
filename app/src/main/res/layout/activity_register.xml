<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/nb_background"
    android:orientation="vertical"
    android:padding="32dp"
    android:gravity="center">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="DAFTAR"
        android:textColor="@color/nb_black"
        android:textSize="36sp"
        android:textStyle="bold"
        android:layout_marginBottom="32dp" />

    <!-- autofillHints="" dan importantForAutofill="no" buat matiin popup Google -->
    <EditText
        android:id="@+id/etEmailReg"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:background="@drawable/nb_edittext_bg"
        android:hint="Email"
        android:inputType="textEmailAddress"
        android:padding="16dp"
        android:textColor="@color/nb_black"
        android:layout_marginBottom="16dp"
        android:importantForAutofill="no"
        android:autofillHints="" />

    <EditText
        android:id="@+id/etPasswordReg"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:background="@drawable/nb_edittext_bg"
        android:hint="Password (Min 8, ada huruf besar & simbol)"
        android:inputType="textPassword"
        android:padding="16dp"
        android:textColor="@color/nb_black"
        android:layout_marginBottom="32dp"
        android:importantForAutofill="no"
        android:autofillHints="" />

    <Button
        android:id="@+id/btnDoRegister"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:background="@drawable/nb_button_bg"
        android:text="DAFTAR SEKARANG"
        android:textColor="@color/nb_white"
        android:textStyle="bold" />

</LinearLayout>
