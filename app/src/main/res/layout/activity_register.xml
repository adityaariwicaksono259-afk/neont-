<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/tg_bg" android:padding="32dp">

    <TextView android:id="@+id/tvTitle" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="Daftar NEONT" android:textSize="32sp" android:textStyle="bold" android:textColor="@color/tg_blue"
        app:layout_constraintTop_toTopOf="parent" app:layout_constraintStart_toStartOf="parent" />

    <EditText android:id="@+id/etEmail" android:layout_width="match_parent" android:layout_height="52dp"
        android:hint="Email" android:inputType="textEmailAddress" android:background="@drawable/bg_input_telegram"
        android:padding="16dp" android:layout_marginTop="24dp" app:layout_constraintTop_toBottomOf="@id/tvTitle" />

    <EditText android:id="@+id/etPassword" android:layout_width="match_parent" android:layout_height="52dp"
        android:hint="Password (Min 8, huruf besar, kecil, angka, simbol)"
        android:inputType="textPassword" android:background="@drawable/bg_input_telegram"
        android:padding="16dp" android:layout_marginTop="16dp" app:layout_constraintTop_toBottomOf="@id/etEmail" />

    <Button android:id="@+id/btnRegister" android:layout_width="match_parent" android:layout_height="52dp"
        android:text="DAFTAR" android:background="@drawable/bg_button_telegram" android:textColor="#FFFFFF"
        android:layout_marginTop="24dp" app:layout_constraintTop_toBottomOf="@id/etPassword" />

    <TextView android:id="@+id/tvGoToLogin" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="Sudah punya akun? Masuk" android:textColor="@color/tg_blue" android:textStyle="bold"
        android:layout_marginTop="16dp" app:layout_constraintTop_toBottomOf="@id/btnRegister"
        app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>
