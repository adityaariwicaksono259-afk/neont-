<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/nb_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp"
        android:gravity="center_horizontal">

        <!-- Foto Profil (Bisa diklik buat ganti nanti) -->
        <ImageView
            android:id="@+id/ivProfilePhoto"
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:src="@drawable/ic_wa_profile"
            android:background="@drawable/nb_box_white"
            android:padding="20dp"
            android:layout_marginTop="32dp"
            android:layout_marginBottom="16dp"
            android:clickable="true"
            android:focusable="true"/>

        <!-- Nama -->
        <TextView
            android:id="@+id/tvProfileName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Nama User"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="@color/nb_black"
            android:layout_marginBottom="4dp"
            android:drawableEnd="@drawable/ic_eye_open"
            android:drawablePadding="8dp"/>

        <!-- Bio/About -->
        <TextView
            android:id="@+id/tvProfileBio"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Halo! Saya menggunakan Neont."
            android:textSize="14sp"
            android:textColor="#666666"
            android:layout_marginBottom="24dp"/>

        <!-- Kotak Info Nomor Neont -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/nb_box_white"
            android:padding="16dp"
            android:orientation="vertical"
            android:layout_marginBottom="16dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Username Anda"
                android:textSize="12sp"
                android:textColor="#888888"/>
            <TextView
                android:id="@+id/tvProfileCode"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="NEO-0000"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="@color/nb_black"/>
        </LinearLayout>

        <!-- Tombol Pengaturan -->
        <Button
            android:id="@+id/btnSettings"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:background="@drawable/nb_button_bg"
            android:text="PENGATURAN &amp; PRIVASI"
            android:textColor="@color/nb_white"
            android:textStyle="bold"
            android:layout_marginBottom="16dp"/>

        <!-- Tombol Logout -->
        <Button
            android:id="@+id/btnLogoutProfile"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:background="@drawable/nb_button_bg"
            android:text="KELUAR"
            android:textColor="@color/nb_white"
            android:textStyle="bold"/>

    </LinearLayout>
</ScrollView>
