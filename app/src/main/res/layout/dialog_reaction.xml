<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:background="@drawable/nb_box_white"
    android:padding="12dp"
    android:layout_gravity="center">
    <TextView android:id="@+id/reactLike" android:layout_width="40dp" android:layout_height="40dp" android:text="👍" android:textSize="24sp" android:gravity="center" android:background="?attr/selectableItemBackground"/>
    <TextView android:id="@+id/reactLove" android:layout_width="40dp" android:layout_height="40dp" android:text="❤️" android:textSize="24sp" android:gravity="center" android:background="?attr/selectableItemBackground"/>
    <TextView android:id="@+id/reactHaha" android:layout_width="40dp" android:layout_height="40dp" android:text="😂" android:textSize="24sp" android:gravity="center" android:background="?attr/selectableItemBackground"/>
</LinearLayout>
