<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/tg_bg">

    <!-- Header -->
    <LinearLayout android:id="@+id/headerHome" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:padding="16dp" android:gravity="center_vertical"
        app:layout_constraintTop_toTopOf="parent">
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:text="NEONT" android:textColor="@color/tg_blue" android:textSize="26sp" android:textStyle="bold"/>
        <ImageView android:layout_width="24dp" android:layout_height="24dp"
            android:src="@android:drawable/ic_menu_more" app:tint="@color/tg_text_gray"/>
    </LinearLayout>

    <!-- List Chat -->
    <androidx.recyclerview.widget.RecyclerView android:id="@+id/rvChats"
        android:layout_width="match_parent" android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/headerHome"
        app:layout_constraintBottom_toBottomOf="parent"/>

    <!-- BOTTOM NAV MELAYANG (SmoothBottomBar) -->
    <me.ibrahimsn.lib.SmoothBottomBar
        android:id="@+id/bottomNav"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_margin="16dp"
        app:backgroundColor="@color/tg_bg"
        app:cornerRadius="30dp"
        app:elevation="8dp"
        app:menu="@menu/bottom_nav_menu"
        app:layout_constraintBottom_toBottomOf="parent"/>

    <!-- BADGE (Angka Notifikasi di Atas Ikon Obrolan) -->
    <TextView
        android:id="@+id/tvBadge"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:background="@drawable/bg_badge"
        android:text="0"
        android:textColor="#FFFFFF"
        android:textSize="10sp"
        android:textStyle="bold"
        android:gravity="center"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="@id/bottomNav"
        app:layout_constraintBottom_toBottomOf="@id/bottomNav"
        app:layout_constraintStart_toStartOf="@id/bottomNav"
        app:layout_constraintEnd_toStartOf="@id/bottomNav"
        app:layout_constraintHorizontal_bias="0.12"
        android:layout_marginTop="8dp"/>
</androidx.constraintlayout.widget.ConstraintLayout>
