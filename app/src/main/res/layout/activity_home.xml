<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/tg_bg">

    <!-- Header -->
    <LinearLayout android:id="@+id/headerHome" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="16dp" app:layout_constraintTop_toTopOf="parent">

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="NEONT" android:textColor="@color/tg_blue" android:textSize="26sp" android:textStyle="bold"
            android:layout_marginBottom="12dp"/>

        <EditText android:id="@+id/etSearchHome" android:layout_width="match_parent" android:layout_height="40dp"
            android:background="@drawable/bg_search_telegram" android:hint="Cari Obrolan"
            android:paddingStart="16dp" android:paddingEnd="16dp" android:textColor="@color/tg_text"
            android:inputType="text" android:importantForAutofill="no"/>
    </LinearLayout>

    <!-- List Chat -->
    <androidx.recyclerview.widget.RecyclerView android:id="@+id/rvChats"
        android:layout_width="match_parent" android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/headerHome" app:layout_constraintBottom_toBottomOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>
