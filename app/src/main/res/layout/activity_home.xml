<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/tg_bg">

    <!-- Header -->
    <LinearLayout android:id="@+id/headerHome" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:padding="16dp" android:gravity="center_vertical"
        app:layout_constraintTop_toTopOf="parent">
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:text="NEONT" android:textColor="@color/tg_blue" android:textSize="24sp" android:textStyle="bold"/>
        <ImageView android:id="@+id/btnMenuTop" android:layout_width="24dp" android:layout_height="24dp"
            android:src="@android:drawable/ic_menu_more" app:tint="@color/tg_text_gray"/>
    </LinearLayout>

    <!-- Search Bar -->
    <LinearLayout android:id="@+id/layoutSearch" android:layout_width="match_parent" android:layout_height="40dp"
        android:background="@drawable/bg_search_telegram" android:orientation="horizontal"
        android:gravity="center_vertical" android:paddingStart="12dp" android:paddingEnd="12dp"
        android:layout_marginStart="16dp" android:layout_marginEnd="16dp" android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@id/headerHome">

        <ImageView android:layout_width="18dp" android:layout_height="18dp"
            android:src="@android:drawable/ic_menu_search" app:tint="@color/tg_text_gray"/>

        <EditText android:id="@+id/etSearchHome" android:layout_width="0dp" android:layout_height="match_parent"
            android:layout_weight="1" android:hint="Cari Obrolan" android:background="@android:color/transparent"
            android:paddingStart="8dp" android:textColor="@color/tg_text" android:textSize="14sp" android:inputType="text"
            android:importantForAutofill="no" android:focusable="true" android:focusableInTouchMode="true"/>
    </LinearLayout>

    <!-- Tab Filter: All, Unread, Neon Combo X -->
    <LinearLayout android:id="@+id/layoutTabs" android:layout_width="match_parent" android:layout_height="36dp"
        android:orientation="horizontal" android:layout_marginStart="16dp" android:layout_marginEnd="16dp"
        android:layout_marginTop="8dp" app:layout_constraintTop_toBottomOf="@id/layoutSearch">

        <TextView android:id="@+id/tabAll" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
            android:text="All" android:gravity="center" android:textColor="@color/tg_blue"
            android:textStyle="bold" android:textSize="14sp" android:background="@drawable/bg_tab_active"/>

        <TextView android:id="@+id/tabUnread" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
            android:text="Unread" android:gravity="center" android:textColor="@color/tg_text_gray" android:textSize="14sp"/>

        <TextView android:id="@+id/tabNeon" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
            android:text="Neon Combo X" android:gravity="center" android:textColor="@color/tg_text_gray" android:textSize="14sp"/>
    </LinearLayout>

    <!-- List Chat -->
    <androidx.recyclerview.widget.RecyclerView android:id="@+id/rvChats"
        android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@id/layoutTabs"
        app:layout_constraintBottom_toTopOf="@id/bottomNav"/>

    <!-- Bottom Nav (Cuma 1) -->
    <LinearLayout android:id="@+id/bottomNav" android:layout_width="match_parent" android:layout_height="60dp"
        android:background="@color/tg_bg" android:elevation="8dp" android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:orientation="vertical" android:gravity="center" android:background="?attr/selectableItemBackground">
            <ImageView android:id="@+id/btnMenuTop" android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/ic_wa_chat" app:tint="@color/tg_blue"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Obrolan" android:textSize="10sp" android:textColor="@color/tg_blue"/>
        </LinearLayout>

        <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:orientation="vertical" android:gravity="center" android:background="?attr/selectableItemBackground">
            <ImageView android:id="@+id/btnMenuTop" android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/ic_wa_profile" app:tint="@color/tg_text_gray"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Kontak" android:textSize="10sp" android:textColor="@color/tg_text_gray"/>
        </LinearLayout>

        <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:orientation="vertical" android:gravity="center" android:background="?attr/selectableItemBackground">
            <ImageView android:id="@+id/btnMenuTop" android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/ic_wa_status" app:tint="@color/tg_text_gray"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Pengaturan" android:textSize="10sp" android:textColor="@color/tg_text_gray"/>
        </LinearLayout>

        <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:orientation="vertical" android:gravity="center" android:background="?attr/selectableItemBackground">
            <ImageView android:id="@+id/btnMenuTop" android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/ic_wa_profile" app:tint="@color/tg_text_gray"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Profil" android:textSize="10sp" android:textColor="@color/tg_text_gray"/>
        </LinearLayout>
    </LinearLayout>

    <!-- Badge (tvBadge) -->
    <TextView android:id="@+id/tvBadge" android:layout_width="20dp" android:layout_height="20dp"
        android:background="@drawable/bg_badge" android:text="0" android:textColor="#FFFFFF"
        android:textSize="10sp" android:textStyle="bold" android:gravity="center"
        android:visibility="gone" app:layout_constraintTop_toTopOf="@id/bottomNav"
        app:layout_constraintBottom_toBottomOf="@id/bottomNav" app:layout_constraintStart_toStartOf="@id/bottomNav"
        app:layout_constraintEnd_toStartOf="@id/bottomNav" app:layout_constraintHorizontal_bias="0.12" android:layout_marginTop="8dp"/>
</androidx.constraintlayout.widget.ConstraintLayout>
