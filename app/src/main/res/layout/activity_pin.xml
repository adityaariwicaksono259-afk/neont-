<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/tg_bg" android:padding="32dp">

    <TextView android:id="@+id/tvTitle" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="Buat PIN Keamanan" android:textSize="28sp" android:textStyle="bold" android:textColor="@color/tg_text"
        app:layout_constraintTop_toTopOf="parent" app:layout_constraintStart_toStartOf="parent" />

    <TextView android:id="@+id/tvKetentuan" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="Ketentuan dan Keamanan" android:textColor="@color/tg_blue" android:textStyle="bold"
        android:layout_marginTop="8dp" app:layout_constraintTop_toBottomOf="@id/tvTitle" app:layout_constraintStart_toStartOf="parent" />

    <TextView android:id="@+id/tvInfo" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="Simpan PIN ini dengan baik. Lupa atau kebocoran PIN di luar tanggung jawab pihak NEONT."
        android:textColor="@color/tg_text_gray" android:textSize="12sp" android:textAlignment="center"
        android:layout_marginTop="16dp" app:layout_constraintTop_toBottomOf="@id/tvKetentuan" />

    <EditText android:id="@+id/etPin" android:layout_width="match_parent" android:layout_height="52dp"
        android:hint="Masukkan 6 digit PIN" android:inputType="number" android:maxLength="6"
        android:background="@drawable/bg_input_telegram" android:padding="16dp" android:textAlignment="center"
        android:textSize="18sp" android:layout_marginTop="24dp" app:layout_constraintTop_toBottomOf="@id/tvInfo" />

    <Button android:id="@+id/btnSavePin" android:layout_width="match_parent" android:layout_height="52dp"
        android:text="SIMPAN PIN" android:background="@drawable/bg_button_telegram" android:textColor="#FFFFFF"
        android:layout_marginTop="24dp" app:layout_constraintTop_toBottomOf="@id/etPin" />
</androidx.constraintlayout.widget.ConstraintLayout>
