<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:padding="12dp"
    android:gravity="center_vertical"
    android:background="@drawable/nb_box_white"
    android:layout_marginBottom="8dp">

    <ImageView android:layout_width="48dp" android:layout_height="48dp" android:src="@drawable/ic_wa_group" android:background="@drawable/bg_avatar_circle" android:padding="10dp"/>

    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:layout_marginStart="12dp">
        <TextView android:id="@+id/tvChannelName" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Nama Saluran" android:textSize="16sp" android:textStyle="bold" android:textColor="#000000"/>
        <TextView android:id="@+id/tvChannelFollowers" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="10 Pengikut" android:textSize="12sp" android:textColor="#888888"/>
    </LinearLayout>

    <Button android:layout_width="wrap_content" android:layout_height="40dp" android:text="Ikuti" android:background="@drawable/nb_button_bg" android:textColor="#FFFFFF" android:textSize="12sp"/>
</LinearLayout>
