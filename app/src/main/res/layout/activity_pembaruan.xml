<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark">

    <!-- Header Glass -->
    <LinearLayout android:id="@+id/headerPembaruan" android:layout_width="match_parent" android:layout_height="60dp" android:background="@drawable/bg_glass_top" android:elevation="4dp" android:padding="16dp" app:layout_constraintTop_toTopOf="parent">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Pembaruan" android:textSize="22sp" android:textStyle="bold" android:textColor="@color/text_white"/>
    </LinearLayout>

    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" app:layout_constraintTop_toBottomOf="@id/headerPembaruan" app:layout_constraintBottom_toTopOf="@id/bottomNavPembaruan">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">

            <!-- Bagian Story -->
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Status" android:textSize="18sp" android:textStyle="bold" android:textColor="@color/text_white" android:layout_marginBottom="12dp"/>

            <HorizontalScrollView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="24dp">
                <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal">
                    
                    <!-- Story Saya -->
                    <LinearLayout 
                        android:id="@+id/layoutStorySaya"
                        android:layout_width="wrap_content" 
                        android:layout_height="wrap_content" 
                        android:orientation="vertical" 
                        android:gravity="center" 
                        android:layout_marginEnd="16dp">
                        <RelativeLayout android:layout_width="72dp" android:layout_height="72dp">
                            <ImageView android:layout_width="72dp" android:layout_height="72dp" android:src="@drawable/ic_wa_profile" android:background="@drawable/bg_story_ring" android:padding="4dp"/>
                            <ImageView android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/ic_wa_plus" android:background="@drawable/bg_avatar_circle" android:layout_alignParentBottom="true" android:layout_alignParentEnd="true" app:tint="#FFFFFF" android:padding="4dp"/>
                        </RelativeLayout>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Story saya" android:textSize="12sp" android:textColor="@color/text_white" android:layout_marginTop="4dp"/>
                    </LinearLayout>

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rvStories"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>
                </LinearLayout>
            </HorizontalScrollView>

            <!-- Bagian Saluran -->
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Saluran" android:textSize="18sp" android:textStyle="bold" android:textColor="@color/text_white" android:layout_marginBottom="12dp"/>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvChannels"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
        </LinearLayout>
    </ScrollView>

    <!-- Bottom Nav Glass -->
    <LinearLayout
        android:id="@+id/bottomNavPembaruan"
        android:layout_width="match_parent"
        android:layout_height="70dp"
        android:background="@drawable/bg_glass_top"
        android:elevation="8dp"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout android:id="@+id/navChatPembaruan" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:orientation="vertical" android:gravity="center" android:background="?attr/selectableItemBackground">
            <ImageView android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/ic_wa_chat" app:tint="@color/text_gray"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Chat" android:textSize="10sp" android:textColor="@color/text_gray"/>
        </LinearLayout>

        <LinearLayout android:id="@+id/navPembaruanPembaruan" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:orientation="vertical" android:gravity="center" android:background="?attr/selectableItemBackground">
            <ImageView android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/ic_wa_status" app:tint="@color/blue_accent"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Pembaruan" android:textSize="10sp" android:textColor="@color/blue_accent"/>
        </LinearLayout>

        <LinearLayout android:id="@+id/navNeontyPembaruan" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:orientation="vertical" android:gravity="center" android:background="?attr/selectableItemBackground">
            <ImageView android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/ic_neonty_box" app:tint="@color/text_gray"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Neonty" android:textSize="10sp" android:textColor="@color/text_gray"/>
        </LinearLayout>

        <LinearLayout android:id="@+id/navPanggilanPembaruan" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:orientation="vertical" android:gravity="center" android:background="?attr/selectableItemBackground">
            <ImageView android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/ic_wa_call" app:tint="@color/text_gray"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Panggilan" android:textSize="10sp" android:textColor="@color/text_gray"/>
        </LinearLayout>

        <LinearLayout android:id="@+id/navProfilePembaruan" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:orientation="vertical" android:gravity="center" android:background="?attr/selectableItemBackground">
            <ImageView android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/ic_wa_profile" app:tint="@color/text_gray"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Profil" android:textSize="10sp" android:textColor="@color/text_gray"/>
        </LinearLayout>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
